MARKU_ENV=development
MARKU_HTTP_ADDR=:36580
MARKU_HTTP_READ_HEADER_TIMEOUT=5s
MARKU_HTTP_READ_TIMEOUT=15s
MARKU_HTTP_WRITE_TIMEOUT=30s
MARKU_HTTP_IDLE_TIMEOUT=60s
MARKU_HTTP_SHUTDOWN_TIMEOUT=10s
MARKU_HTTP_MAX_BODY_BYTES=1048576
MARKU_HTTP_TRUSTED_PROXIES=

MARKU_DB_DRIVER=sqlite
MARKU_DB_DSN=./data/marku.db
# SQLite defaults; increase these for MySQL/PostgreSQL.
MARKU_DB_MAX_OPEN_CONNS=1
MARKU_DB_MAX_IDLE_CONNS=1
MARKU_DB_CONN_MAX_LIFETIME=30m
MARKU_DB_AUTO_MIGRATE=true

# Required in production and whenever admin credentials are set.
# Production requires at least 32 characters.
MARKU_JWT_SECRET=
MARKU_JWT_TTL=8h

# Set both to seed the initial admin on first startup.
# The password is only used when the admin is first created.
MARKU_ADMIN_EMAIL=
MARKU_ADMIN_PASSWORD=

MARKU_CORS_ALLOWED_ORIGINS=http://localhost:36581,http://127.0.0.1:36581
MARKU_CORS_ALLOW_CREDENTIALS=false
MARKU_CORS_MAX_AGE=12h

MARKU_RATE_LIMIT_ENABLED=true
MARKU_RATE_LIMIT_RPS=20
MARKU_RATE_LIMIT_BURST=40

MARKU_COMMENT_RATE_LIMIT_WINDOW=10m
MARKU_COMMENT_RATE_LIMIT_MAX=5
MARKU_COMMENT_MIN_SUBMIT_DURATION=2s
MARKU_COMMENT_MAX_LENGTH=2000
MARKU_COMMENT_MAX_LINKS=3
MARKU_COMMENT_MAX_DEPTH=3
MARKU_COMMENT_DUPLICATE_WINDOW=10m

# Required in production; use a long random string.
MARKU_IP_HASH_SALT=

MARKU_VIEW_DEDUPE_BY_VISITOR_DAY=false
MARKU_VIEW_FILTER_BOTS=true
MARKU_VIEW_MAX_BATCH_PATHS=50

MARKU_LOG_LEVEL=info
MARKU_LOG_FORMAT=text
